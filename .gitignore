########################################
# GLOBAL
########################################

# Ignore system files
.DS_Store
Thumbs.db

# Ignore VSCode, JetBrains
.vscode/
.idea/
**/.vscode/
**/.idea/

########################################
# PYTHON / FASTAPI BACKEND
########################################

# Virtual environments
venv/
env/
.venv/
**/venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
*.pyo
*.pyd

# Python build/dist
build/
dist/
*.egg-info
**/*.egg-info
.eggs/

# Pydantic, MyPy, cache
.mypy_cache/
.pytest_cache/
pip-wheel-metadata/

# Ignore .env files anywhere
*.env
**/*.env
*.env.local
*.env.*.local

# FastAPI logs
*.log
**/*.log
/Backend/app/app.log

# Local database files
Backend/chroma_db/
Backend/chroma_db/*.sqlite3
Backend/app/vectorstore_test/*.sqlite3

# Uploaded files
Backend/uploads/
**/uploads/

########################################
# FRONTEND / REACT
########################################

# Node modules
node_modules/
**/node_modules/

# Build output
build/
dist/
**/build/
**/dist/

# Environment files
*.env.development.local
*.env.test.local
*.env.production.local
*.env.local

# React logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

########################################
# OPTIONAL IGNORE (remove if needed)
########################################

# Local Python config
.pyenv/
pythonconfig.json

# TypeScript errors cache
*.tsbuildinfo

########################################
# PROJECT SPECIFIC (Backend folder)
########################################

/Backend/.env
/Backend/chroma_db/chroma.sqlite3
/Backend/app/app.log

**/app.log
**/*.log
*.log

**/*.zip
**/*.env
