# Required
N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/your-hook

# Optional (comma-separated). Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Optional
LOG_LEVEL=INFO

# Optional: set to 1 to enable /api/transcribe (requires installing whisper deps)
ENABLE_TRANSCRIBE=0
