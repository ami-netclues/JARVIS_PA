# Required
N8N_WEBHOOK_URL="https://n8n.hostitsmart.com/webhook/2a842b2d-2345-4fc1-a399-1838ac2c1da8"

# Optional (comma-separated). Example: https://yourdomain.com,https://www.yourdomain.com
# ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS="*"

# Optional
LOG_LEVEL=INFO

# # Optional: set to 1 to enable /api/transcribe (requires installing whisper deps)
# ENABLE_TRANSCRIBE=0


# # Optional: voice authentication (requires installing speechbrain/torch deps)
# VOICE_AUTH_ENABLED=0

# # Optional: stricter/higher threshold means fewer false accepts but more false rejects
# VOICE_AUTH_THRESHOLD=0.75

# # Optional
# VOICE_AUTH_STORE_DIR=data/voice_users